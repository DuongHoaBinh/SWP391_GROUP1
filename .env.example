# Backend API (NestJS)
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=horse_transport_system
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3001

# Development-only internal account seed. Never commit real passwords here.
# Format: [{"email":"manager@example.com","password":"...","role":"LOGISTICS_MANAGER"}]
AUTH_INTERNAL_USERS_JSON=
AUTH_EXPOSE_DEV_OTP=false

# Gmail SMTP sender account for the system. This is NOT the customer's email.
# Customer email is supplied in POST /api/auth/register and receives the OTP.
# Use a Gmail App Password, not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Example: racehorse.transport.system@gmail.com
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-gmail@gmail.com
SMTP_REQUIRED=true

# Frontend (Next.js/React)
FRONTEND_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Optional integrations
FILE_STORAGE_PROVIDER=local
TRACKING_PROVIDER=mock

# SePay Test Mode & VietQR Automated Bank Transfer Payment
SEPAY_WEBHOOK_API_KEY=equitransit-sepay-test-apikey-2026
PAYMENT_CODE_PREFIX=EQT
PAYMENT_EXPIRE_HOURS=48
BANK_CODE=MBBank
BANK_ACCOUNT_NO=0000123456789
BANK_ACCOUNT_NAME=CONG TY VAN CHUYEN NGUA EQUITRANSIT
PAYMENT_DEV_SIMULATE=true

# MoMo domestic ATM sandbox (legacy fallback)
MOMO_SANDBOX_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX0qPDp5Jm0qwnm
MOMO_REDIRECT_ORIGIN=http://localhost:3001
MOMO_IPN_URL=http://localhost:5000/api/orders/payments/momo/ipn

# Backend API (NestJS)
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=horse_transport_system
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000

# Development-only internal account seed. Never commit real passwords here.
# Format: [{"email":"manager@example.com","password":"...","role":"LOGISTICS_MANAGER"}]
AUTH_INTERNAL_USERS_JSON=
AUTH_EXPOSE_DEV_OTP=false

# Gmail SMTP sender account for the system. This is NOT the customer's email.
# Customer email is supplied in POST /api/auth/register and receives the OTP.
# Use a Gmail App Password, not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Example: racehorse.transport.system@gmail.com
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-gmail@gmail.com
SMTP_REQUIRED=true

# Frontend (Next.js/React)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Optional integrations
FILE_STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=console
# Tracking reads persisted events from MySQL; no mock provider is used.
# SePay real bank transfers. Keep all secrets backend-only.
# Configure SePay alongside DB/JWT/SMTP in backend/.env (gitignored).
SEPAY_ENABLED=false
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
SEPAY_PAYMENT_PREFIX=DH
# Numeric suffix. Match the DH pattern configured on SePay (default: 6-8 digits).
SEPAY_CODE_LENGTH=8
# Local-only webhook gateway preserves the existing public tunnel URL.
SEPAY_WEBHOOK_PORT=5002
SEPAY_BACKEND_URL=http://127.0.0.1:5000

# Database (MySQL 8.0+)
# PAYMENT_GATE_ISOLATED is an internal test guard, set only by npm run test:payment-gate.
# Leave it unset in application environments; the test runner creates a disposable MySQL container.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=horse_transport_system
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_CONNECTION_LIMIT=20

# Security & Authentication
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
FRONTEND_ORIGIN=http://localhost:3001
ENABLE_SWAGGER=true

# Development-only internal account seed & demo toggles. Never commit real passwords here.
# Format: [{"email":"manager@example.com","password":"...","role":"LOGISTICS_MANAGER"}]
AUTH_INTERNAL_USERS_JSON=[]
AUTH_EXPOSE_DEV_OTP=false
SEED_DEMO_DATA=false

# Backend (NestJS)
PORT=5000
NODE_ENV=development

# SMTP / Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-gmail@gmail.com
SMTP_REQUIRED=false

# Frontend (Next.js/React)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Optional integrations
FILE_STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=console

# SePay automated bank transfer payments via VietQR and Webhook
SEPAY_ENABLED=false
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=0000123456789
SEPAY_ACCOUNT_NAME=CONG TY VAN CHUYEN NGUA EQUITRANSIT
SEPAY_WEBHOOK_SECRET=replace-with-sepay-hmac-secret-min-32-chars
SEPAY_PAYMENT_PREFIX=DH
SEPAY_CODE_LENGTH=8
SEPAY_WEBHOOK_PORT=5002
SEPAY_BACKEND_URL=http://127.0.0.1:5000
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# MoMo Sandbox Payment (Dev/Test only)
MOMO_SANDBOX_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_ORIGIN=http://localhost:3001
MOMO_IPN_URL=http://localhost:5000/api/orders/payments/momo/ipn

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional insurance valuation rate, VND per USD (positive, maximum 6 decimal places).
# Leave empty to accept VND declarations only. Use your team's approved rate.
# This is snapshotted per shipment horse and never changes existing declarations.
INSURANCE_USD_TO_VND=

# OpenRouteService (khoảng cách đường bộ cho xe tải, profile driving-hgv). Để trống thì dùng ước lượng Haversine × hệ số.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
DISTANCE_FALLBACK_FACTOR=1.3
# Thời gian giữ giá của một báo giá (phút)
QUOTE_TTL_MINUTES=30
# Cửa sổ thời hạn khiếu nại bồi thường bảo hiểm sau bàn giao (giờ, mặc định 72)
INSURANCE_CLAIM_WINDOW_HOURS=72

# Chế độ giả lập tracking GPS (demo)
TRACKING_SIMULATION_ENABLED=false

# Mật khẩu khởi tạo cho tài khoản demo khi chạy npm run seed:demo
# Bắt buộc khai báo khi chạy seed:demo (tối thiểu 8 ký tự, không dùng mật khẩu thật)
DEMO_ACCOUNT_PASSWORD=



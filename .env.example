# Database (MySQL 8.0+)
# PAYMENT_GATE_ISOLATED is an internal test guard, set only by npm run test:payment-gate.
# Leave it unset in application environments; the test runner creates a disposable MySQL container.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=horse_transport_system
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3001

# Development-only internal account seed. Never commit real passwords here.
# Format: [{"email":"manager@example.com","password":"...","role":"LOGISTICS_MANAGER"}]
INTERNAL_SEED_ACCOUNTS=[]

# Backend (NestJS)
PORT=5000
NODE_ENV=development

# SMTP / Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-gmail@gmail.com
SMTP_REQUIRED=false

# Frontend (Next.js/React)
FRONTEND_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Optional integrations
FILE_STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=console

# SePay automated bank transfer payments via VietQR and Webhook
SEPAY_ENABLED=false
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=0000123456789
SEPAY_ACCOUNT_NAME=CONG TY VAN CHUYEN NGUA EQUITRANSIT
SEPAY_WEBHOOK_SECRET=replace-with-sepay-hmac-secret-min-32-chars
SEPAY_PAYMENT_PREFIX=DH
SEPAY_CODE_LENGTH=8
SEPAY_WEBHOOK_PORT=5002
SEPAY_BACKEND_URL=http://127.0.0.1:5000
NGROK_AUTHTOKEN=
NGROK_DOMAIN=


# Optional insurance valuation rate, VND per USD (positive, maximum 6 decimal places).
# Leave empty to accept VND declarations only. Use your team's approved rate.
# This is snapshotted per shipment horse and never changes existing declarations.
INSURANCE_USD_TO_VND=

{
  "name": "racehorse-transport-backend",
  "private": true,
  "scripts": {
    "migrate:booking": "node ../database/apply-booking-migration.cjs",
    "test:booking": "npm run build && node scripts/test-payment-gate.cjs",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test:sepay": "npm run build && node --test test/sepay.integration.cjs",
    "test:payment-gate": "npm run build && node scripts/test-payment-gate.cjs",
    "test:insurance": "npm run build && node scripts/test-payment-gate.cjs",
    "migrate:insurance": "node ../database/apply-insurance-migration.cjs",
    "migrate:payment-gate": "node ../database/apply-payment-gate-migration.cjs",
    "migrate:sepay": "node ../database/apply-sepay-migration.cjs",
    "migrate:road-trips": "node ../database/apply-road-trip-migration.cjs",
    "test:controlled": "npm run build && node --test test/controlled-fixes.test.cjs test/road-trips-policy.test.cjs test/merge-resolution.test.cjs",
    "migrate:transport-mode": "node ../database/apply-transport-mode-migration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.3",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.7.2"
  }
}
